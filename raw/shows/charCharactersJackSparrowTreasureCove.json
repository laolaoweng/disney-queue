      "importantInfo": [
        {
          "id": "pleaseNoteCharacter",
          "group": "Important Info",
          "items": [
            {
              "name": "请注意",
              "description": "<p>请始终遵从现场演职人员的指引。由于见面会受载客量的限制，排队截止时间将以现场运营情况为准。</p>",
