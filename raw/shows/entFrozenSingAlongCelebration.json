      "importantInfo": [
        {
          "id": "pleaseNoteShow",
          "group": "Important Info",
          "items": [
            {
              "name": "请注意",
              "description": "<p>每场演出座位有限。当剧院满座时或在演出开始前10分钟，剧院大门将关闭。请您与所有同行人员到达后一同排队，如果您有任何问题，请咨询现场演职人员。</p>",
              "endTime": null,
              "openTime": null
