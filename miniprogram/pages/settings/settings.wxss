/* pages/settings/settings.wxss —— 偏好设置 */

.section {
  margin: 0 24rpx 20rpx;
  padding: 30rpx 28rpx;
}

.card-title-note {
  margin-left: 10rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #5a6a82;
}

.hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #5a6a82;
}

.hint.warn {
  color: #96630a;
}

/* 同行类型 2x2 */
.party-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 4rpx -8rpx 0;
}

.party {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  padding: 22rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(31, 88, 160, 0.05);
  border: 1rpx solid rgba(31, 88, 160, 0.07);
  box-sizing: border-box;
}

.party.on {
  background: rgba(47, 124, 246, 0.10);
  border-color: rgba(47, 124, 246, 0.4);
}

.party-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #16233a;
}

.party.on .party-label {
  color: #164f9e;
}

.party-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: #5a6a82;
}

/* chips */
.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.chip {
  padding: 14rpx 26rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #66748c;
  background: rgba(31, 88, 160, 0.06);
  border: 1rpx solid rgba(31, 88, 160, 0.07);
}

.chip.small {
  padding: 10rpx 22rpx;
  font-size: 22rpx;
}

.chip.on {
  background: rgba(47, 124, 246, 0.12);
  border-color: rgba(47, 124, 246, 0.35);
  color: #164f9e;
  font-weight: 600;
}

/* 身高 */
.height-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.height-input {
  flex: 1;
  height: 76rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: rgba(31, 88, 160, 0.06);
  color: #16233a;
  font-size: 28rpx;
}

.height-unit {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: #5a6a82;
}

/* picker */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(31, 88, 160, 0.06);
}

.picker-value {
  font-size: 28rpx;
  color: #16233a;
}

.picker-arrow {
  font-size: 34rpx;
  color: #5a6a82;
}

/* tabs */
.tabs {
  display: flex;
  margin-top: 18rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: rgba(31, 88, 160, 0.05);
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 0;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #66748c;
}

.tab.on {
  background: rgba(47, 124, 246, 0.12);
  color: #164f9e;
}

.tab-count {
  margin-left: 8rpx;
  font-size: 20rpx;
  opacity: 0.8;
}

/* 项目列表 */
.attr-list {
  margin-top: 8rpx;
}

.attr {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(31, 88, 160, 0.07);
}

.attr:last-child {
  border-bottom: none;
}

.attr-main {
  flex: 1;
  min-width: 0;
}

.attr-name {
  display: block;
  font-size: 28rpx;
  color: #16233a;
}

.attr.on .attr-name {
  color: #164f9e;
}

.attr-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #5a6a82;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.attr-toggle {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #66748c;
  background: rgba(31, 88, 160, 0.07);
}

.attr-toggle.on {
  color: #164f9e;
  background: rgba(47, 124, 246, 0.12);
}

/* 已玩过 */
.played-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.played {
  padding: 12rpx 22rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #66748c;
  background: rgba(31, 88, 160, 0.06);
}

/* 其他 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0;
}

.switch-label {
  font-size: 28rpx;
  color: #16233a;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.info-label {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #5a6a82;
}

.info-value {
  flex: 1;
  font-size: 22rpx;
  color: #66748c;
  line-height: 1.5;
}

.info-value.url {
  word-break: break-all;
  font-size: 20rpx;
  color: #5a6a82;
}

.link {
  margin-top: 22rpx;
  font-size: 26rpx;
  color: #164f9e;
}

.link.danger {
  color: #c9302c;
}

/* 当前推荐预览 */
.preview-card {
  display: flex;
  align-items: center;
  margin: 0 24rpx 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(120deg, rgba(47, 124, 246, 0.12), rgba(47, 124, 246, 0.05));
  border: 1rpx solid rgba(47, 124, 246, 0.16);
}

.preview-label {
  flex-shrink: 0;
  margin-right: 16rpx;
  font-size: 20rpx;
  color: #164f9e;
  letter-spacing: 2rpx;
}

.preview-text {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  color: #16233a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.preview-go {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #164f9e;
}