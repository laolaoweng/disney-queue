/* pages/plan/plan.wxss —— 行程时间线 */

.sk-card {
  padding: 40rpx 32rpx;
}

.sk-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.06);
  margin-bottom: 22rpx;
}

.sk-line.w50 { width: 50%; }
.sk-line.w70 { width: 70%; }
.sk-line.w90 { width: 90%; }

/* 摘要 */
.plan-head {
  padding: 32rpx;
}

.plan-head-row {
  display: flex;
  align-items: flex-end;
}

.plan-head-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.plan-head-num {
  font-size: 64rpx;
  line-height: 1;
  color: #ff8a3d;
}

.plan-head-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6f7a8c;
}

.plan-head-time {
  display: flex;
  align-items: baseline;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
}

.plan-time-now {
  font-size: 32rpx;
  font-weight: 600;
  color: #dfe6f0;
}

.plan-time-arrow {
  margin: 0 16rpx;
  color: #5f6a7a;
}

.plan-time-end {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffab6b;
}

.plan-time-label {
  margin-left: auto;
  font-size: 22rpx;
  color: #6f7a8c;
}

/* 时间线 */
.timeline {
  padding: 0 24rpx;
}

.step {
  display: flex;
  align-items: stretch;
}

.step-left {
  width: 56rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 26rpx;
}

.step-index {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 138, 61, 0.16);
  color: #ffab6b;
  font-size: 24rpx;
  flex-shrink: 0;
}

.step-line {
  flex: 1;
  width: 2rpx;
  margin: 10rpx 0;
  background: rgba(255, 255, 255, 0.08);
}

.step-body {
  flex: 1;
  margin: 0 0 20rpx 12rpx;
  padding: 26rpx 28rpx;
}

.step-played .step-body {
  opacity: 0.55;
}

.step-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.step-time {
  display: flex;
  align-items: baseline;
}

.step-start {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffab6b;
}

.step-dash {
  margin: 0 8rpx;
  color: #5f6a7a;
}

.step-end {
  font-size: 24rpx;
  color: #8b97aa;
}

.step-played-btn {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.06);
  color: #9aa6b8;
}

.step-played-btn.on {
  background: rgba(53, 208, 127, 0.14);
  color: #5fe0a0;
}

.step-name {
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #eef2f7;
}

.step-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.step-meta-text {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #6f7a8c;
}

.note {
  margin: 8rpx 40rpx 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 176, 32, 0.1);
  color: #ffc65c;
  font-size: 24rpx;
  text-align: center;
}

.empty-btn {
  display: inline-block;
  margin-top: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: rgba(255, 138, 61, 0.16);
  color: #ffab6b;
  font-size: 26rpx;
}

/* 步骤操作按钮组 */
.step-btns {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.step-start-btn {
  margin-right: 12rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: rgba(255, 138, 61, 0.14);
  border: 1rpx solid rgba(255, 138, 61, 0.28);
  color: #ffab6b;
}