/* pages/plan/plan.wxss —— 行程时间线 */

.sk-card {
  padding: 40rpx 32rpx;
}

.sk-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: rgba(31, 88, 160, 0.07);
  margin-bottom: 22rpx;
}

.sk-line.w50 { width: 50%; }
.sk-line.w70 { width: 70%; }
.sk-line.w90 { width: 90%; }

/* 摘要 */
.plan-head {
  padding: 32rpx;
}

.plan-head-row {
  display: flex;
  align-items: flex-end;
}

.plan-head-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.plan-head-num {
  font-size: 64rpx;
  line-height: 1;
  color: #164f9e;
}

.plan-head-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #5a6a82;
}

.plan-head-time {
  display: flex;
  align-items: baseline;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(31, 88, 160, 0.08);
}

.plan-time-now {
  font-size: 32rpx;
  font-weight: 600;
  color: #16233a;
}

.plan-time-arrow {
  margin: 0 16rpx;
  color: #5f6f87;
}

.plan-time-end {
  font-size: 32rpx;
  font-weight: 600;
  color: #164f9e;
}

.plan-time-label {
  margin-left: auto;
  font-size: 22rpx;
  color: #5a6a82;
}

/* 时间线 */
.timeline {
  padding: 0 24rpx;
}

.step {
  display: flex;
  align-items: stretch;
}

.step-left {
  width: 56rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 26rpx;
}

.step-index {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(47, 124, 246, 0.12);
  color: #164f9e;
  font-size: 24rpx;
  flex-shrink: 0;
}

.step-line {
  flex: 1;
  width: 2rpx;
  margin: 10rpx 0;
  background: rgba(31, 88, 160, 0.10);
}

.step-body {
  flex: 1;
  margin: 0 0 20rpx 12rpx;
  padding: 26rpx 28rpx;
}

.step-played .step-body {
  opacity: 0.55;
}

.step-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.step-time {
  display: flex;
  align-items: baseline;
}

.step-start {
  font-size: 28rpx;
  font-weight: 600;
  color: #164f9e;
}

.step-dash {
  margin: 0 8rpx;
  color: #5f6f87;
}

.step-end {
  font-size: 24rpx;
  color: #66748c;
}

.step-played-btn {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: rgba(31, 88, 160, 0.07);
  color: #66748c;
}

.step-played-btn.on {
  background: rgba(23, 166, 115, 0.14);
  color: #0d7a52;
}

.step-name {
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #16233a;
}

.step-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.step-meta-text {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #5a6a82;
}

.note {
  margin: 8rpx 40rpx 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(232, 163, 23, 0.12);
  color: #96630a;
  font-size: 24rpx;
  text-align: center;
}

.empty-btn {
  display: inline-block;
  margin-top: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: rgba(47, 124, 246, 0.12);
  color: #164f9e;
  font-size: 26rpx;
}

/* 步骤操作按钮组 */
.step-btns {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.step-start-btn {
  margin-right: 12rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: rgba(47, 124, 246, 0.10);
  border: 1rpx solid rgba(47, 124, 246, 0.20);
  color: #164f9e;
}