/* pages/shows/shows.wxss —— 演出：2 列方形卡片 + 时间胶囊 + 倒计时（浅色主题） */

/* 顶部筛选 */
.show-seg {
  display: flex;
  margin: 0 24rpx 20rpx;
  padding: 6rpx;
  background: #ffffff;
  border-radius: 999rpx;
  border: 1rpx solid rgba(31, 88, 160, 0.06);
  box-shadow: 0 4rpx 12rpx rgba(31, 88, 160, 0.06);
}

.show-seg-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #66748c;
  border-radius: 999rpx;
}

.show-seg-item.active {
  background: #eaf2ff;
  color: #164f9e;
  font-weight: 600;
}

/* 网格 */
.show-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 24rpx;
}

/* 卡片 */
.show-card {
  width: calc(50% - 12rpx);
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(31, 88, 160, 0.06);
  box-shadow: 0 6rpx 18rpx rgba(31, 88, 160, 0.08);
}

.show-card.is-off {
  opacity: 0.78;
}

/* 方形图 */
.show-pic {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  background: linear-gradient(150deg, #eaf2ff 0%, #dbe9ff 100%);
}

.show-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.show-ph {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.show-ph-emoji {
  font-size: 64rpx;
  opacity: 0.55;
}

.show-land {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  color: #164f9e;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(47, 124, 246, 0.18);
}

.show-off {
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  color: #ffffff;
  background: rgba(22, 35, 58, 0.55);
}

/* 文字区 */
.show-body {
  padding: 18rpx 18rpx 20rpx;
}

.show-name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 26rpx;
  line-height: 1.35;
  min-height: 70rpx;
  color: #16233a;
  font-weight: 600;
}

/* 第一行时间胶囊：最近场次 + 倒计时 */
.show-time-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.show-time-pill {
  padding: 2rpx 12rpx;
  margin-right: 8rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  color: #164f9e;
  background: #eaf2ff;
}

.show-cd {
  font-size: 20rpx;
  color: #164f9e;
}

.show-cd.cd-now {
  color: #0d7a52;
  font-weight: 600;
}

.show-cd.cd-soon {
  color: #96630a;
  font-weight: 600;
}

.show-cd.cd-closed {
  color: #64748c;
}

.show-cd.cd-none {
  color: #64748c;
}

/* 第二行：下一场（浅灰） */
.show-next-row {
  margin-top: 8rpx;
}

.show-next {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #66748c;
  background: rgba(31, 88, 160, 0.06);
}

/* 骨架 */
.sk-card {
  padding: 0;
  overflow: hidden;
}

.show-sk {
  padding-bottom: 20rpx;
}

.sk-pic {
  width: 100%;
  padding-bottom: 100%;
  background: rgba(31, 88, 160, 0.07);
  margin-bottom: 16rpx;
}

.sk-line {
  height: 24rpx;
  margin: 0 18rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(31, 88, 160, 0.07);
}

.sk-line.w80 {
  width: 80%;
}

.sk-line.w60 {
  width: 60%;
}

/* 空态按钮（页面局部） */
.empty-btn {
  display: inline-block;
  margin-top: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: #164f9e;
  color: #ffffff;
  font-size: 26rpx;
  box-shadow: 0 8rpx 20rpx rgba(47, 124, 246, 0.28);
}
