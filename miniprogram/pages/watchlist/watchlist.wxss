/* pages/watchlist/watchlist.wxss —— 清单：汇总卡 + 已选排序 + 按园区勾选 */

/* 骨架屏 / 空态按钮（页面局部，不依赖其它页面 wxss） */
.sk-card { padding: 40rpx 32rpx; }
.sk-line { height: 28rpx; border-radius: 8rpx; background: rgba(31, 88, 160, 0.07); margin-bottom: 24rpx; }
.sk-line.big { height: 64rpx; }
.sk-line.w40 { width: 40%; }
.sk-line.w60 { width: 60%; }
.sk-line.w70 { width: 70%; }
.sk-line.w90 { width: 90%; }

.empty-btn {
  display: inline-block;
  margin-top: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: rgba(47, 124, 246, 0.12);
  color: #164f9e;
  font-size: 26rpx;
}

/* ---------- 汇总卡 ---------- */
.sum-card {
  padding: 36rpx 32rpx 28rpx;
  background: linear-gradient(160deg, #f2f7ff 0%, #ffffff 55%, #ffffff 100%);
  border-color: rgba(47, 124, 246, 0.12);
  box-shadow: 0 12rpx 32rpx rgba(47, 124, 246, 0.12);
}

.sum-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.sum-top-left { flex: 1; }

.sum-label {
  display: block;
  font-size: 24rpx;
  color: #66748c;
  letter-spacing: 1rpx;
}

.sum-num-line {
  display: flex;
  align-items: baseline;
  margin-top: 6rpx;
}

.sum-num {
  font-size: 92rpx;
  line-height: 1.05;
  color: #16233a;
  letter-spacing: -2rpx;
}

.sum-unit {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #66748c;
}

.sum-finish {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #164f9e;
}

.sum-badge {
  min-width: 128rpx;
  padding: 16rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(47, 124, 246, 0.10);
  text-align: center;
  margin-left: 20rpx;
}

.sum-badge-num {
  display: block;
  font-size: 44rpx;
  color: #164f9e;
}

.sum-badge-label {
  display: block;
  font-size: 20rpx;
  color: #66748c;
}

.sum-grid {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(31, 88, 160, 0.10);
}

.sum-item {
  flex: 1;
  text-align: center;
}

.sum-item + .sum-item {
  border-left: 1rpx solid rgba(31, 88, 160, 0.10);
}

.sum-item-num {
  display: block;
  font-size: 40rpx;
  color: #16233a;
}

.sum-item-label {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #5a6a82;
}

.sum-summary {
  display: block;
  margin-top: 22rpx;
  font-size: 22rpx;
  color: #66748c;
  line-height: 1.6;
}

.sum-error {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(229, 72, 77, 0.12);
  color: #c9302c;
  font-size: 22rpx;
}

.sum-warn {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #96630a;
}

/* ---------- 区块头 ---------- */
.section { margin-top: 8rpx; }

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 40rpx 18rpx;
}

.section-title { font-size: 28rpx; font-weight: 600; color: #4a5b78; }
.section-link { font-size: 24rpx; color: #164f9e; }

/* ---------- 已选列表 ---------- */
.order-card {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
}

.order-index {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(47, 124, 246, 0.10);
  color: #164f9e;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.order-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.order-name-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.order-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #16233a;
  margin-right: 10rpx;
}

.order-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #5a6a82;
}

.order-time {
  display: flex;
  align-items: baseline;
  margin-top: 10rpx;
}

.order-time-label {
  font-size: 20rpx;
  color: #5a6a82;
  margin-right: 8rpx;
}

.order-time-label:last-child {
  margin-left: 8rpx;
  margin-right: 0;
}

.order-time-num {
  font-size: 24rpx;
  color: #66748c;
  font-variant-numeric: tabular-nums;
}

.order-time-dash {
  margin: 0 6rpx;
  color: #5f6f87;
}

.order-right {
  text-align: right;
  flex-shrink: 0;
}

.order-wait {
  font-size: 44rpx;
}

.order-unit {
  display: block;
  font-size: 20rpx;
  color: #5a6a82;
}

.order-remove {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #164f9e;
}

/* ---------- 空清单 ---------- */
.empty-watch {
  text-align: center;
  padding: 48rpx 40rpx;
}

.empty-watch .empty-emoji { display: block; font-size: 56rpx; margin-bottom: 12rpx; }
.empty-watch .empty-title { display: block; font-size: 30rpx; font-weight: 600; color: #16233a; margin-bottom: 10rpx; }

/* ---------- 全部项目 ---------- */
.group-card {
  padding: 8rpx 26rpx 6rpx;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 4rpx 12rpx;
}

.group-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #66748c;
  letter-spacing: 1rpx;
}

.group-count {
  font-size: 20rpx;
  color: #5f6f87;
}

.pick-row {
  display: flex;
  align-items: center;
  padding: 22rpx 4rpx;
  border-top: 1rpx solid rgba(31, 88, 160, 0.06);
}

.pick-row.off { opacity: 0.55; }

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  border: 2rpx solid rgba(31, 88, 160, 0.20);
  margin-right: 22rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.checkbox.on {
  background: #164f9e;
  border-color: #164f9e;
}

.checkbox-mark {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.pick-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.pick-name-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.pick-name {
  font-size: 28rpx;
  color: #16233a;
  margin-right: 8rpx;
}

.pick-off {
  color: #5a6a82;
}

.pick-sub {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #5f6f87;
}

.pick-right {
  text-align: right;
  flex-shrink: 0;
}

.pick-wait {
  font-size: 34rpx;
}

.pick-unit {
  display: block;
  font-size: 20rpx;
  color: #5a6a82;
}

.pick-row.picked .pick-name {
  color: #164f9e;
}
