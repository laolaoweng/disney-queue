/* pages/rank/rank.wxss —— 排行榜列表 */

.sk-card {
  padding: 40rpx 32rpx;
}

.sk-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.06);
  margin-bottom: 22rpx;
}

.sk-line.w40 { width: 40%; }
.sk-line.w60 { width: 60%; }
.sk-line.w90 { width: 90%; }

/* 排序切换 */
.sortbar {
  display: flex;
  margin: 0 24rpx 20rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #151b26;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.sort-item {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #8b97aa;
}

.sort-item.active {
  background: rgba(255, 138, 61, 0.14);
  color: #ffab6b;
  font-weight: 600;
}

/* 列表 */
.list {
  margin: 0 24rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #151b26;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.row {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.row:last-child {
  border-bottom: none;
}

.row-off {
  opacity: 0.45;
}

.row-rank {
  width: 44rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #5f6a7a;
  text-align: center;
}

.row-rank.top {
  color: #ff8a3d;
}

.row-main {
  flex: 1;
  padding: 0 18rpx;
  overflow: hidden;
}

.row-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.row-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #eef2f7;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tag {
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  line-height: 1.6;
}

.tag.must {
  background: rgba(255, 138, 61, 0.16);
  color: #ffab6b;
}

.tag.avoid {
  background: rgba(255, 93, 93, 0.14);
  color: #ff8f8f;
}

.tag.premier {
  background: rgba(255, 214, 102, 0.14);
  color: #ffd666;
}

.tag.here {
  background: rgba(80, 160, 255, 0.16);
  color: #7fb8ff;
}

.tag.played {
  background: rgba(255, 255, 255, 0.08);
  color: #9aa6b8;
}

.row-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6f7a8c;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.row-excluded {
  display: inline-block;
  margin-top: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.06);
  color: #8b97aa;
}

.row-walk {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #5f6a7a;
}

.row-right {
  width: 160rpx;
  flex-shrink: 0;
  text-align: right;
}

.row-wait {
  font-size: 52rpx;
  line-height: 1;
  letter-spacing: -1rpx;
}

.row-wait-unit {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #6f7a8c;
}

.row-score {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #5f6a7a;
}

/* 园区分组 */
.groupbar {
  display: flex;
  align-items: center;
  margin: 0 24rpx 20rpx;
}

.group-toggle {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #151b26;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 24rpx;
  color: #8b97aa;
}

.group-toggle.on {
  background: rgba(255, 138, 61, 0.14);
  border-color: rgba(255, 138, 61, 0.3);
  color: #ffab6b;
  font-weight: 600;
}

.groupbar-tip {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #5a6473;
}

.group {
  margin: 0 24rpx 20rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #151b26;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: rgba(255, 255, 255, 0.03);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.group-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #dfe6f0;
}

.group-count {
  font-size: 22rpx;
  color: #6f7a8c;
}

/* ---------- 分时预测入口 ---------- */
.forecast-entry {
  display: flex;
  align-items: center;
  margin: 0 24rpx 20rpx;
  padding: 22rpx 24rpx;
  background: linear-gradient(135deg, rgba(255, 138, 61, 0.12), rgba(21, 27, 38, 0.9));
  border: 1rpx solid rgba(255, 138, 61, 0.22);
}

.fe-emoji {
  font-size: 38rpx;
  margin-right: 18rpx;
}

.fe-texts {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.fe-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #f2f5f9;
}

.fe-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8fa0b5;
}

.fe-arrow {
  font-size: 36rpx;
  color: #ff8a3d;
  margin-left: 16rpx;
}


/* ---------------- 排队榜：图片卡片网格（参考界面风格） ---------------- */
.list-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 10rpx 24rpx 16rpx;
}

.refresh-pill {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(96, 165, 250, 0.35);
  background: rgba(59, 130, 246, 0.12);
  color: #7fb3ff;
  font-size: 24rpx;
  font-weight: 600;
}

.update-time {
  font-size: 22rpx;
  color: #7a8494;
}

.tile-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin: 0 24rpx;
}

.tile {
  width: 23.2%;
  margin-bottom: 18rpx;
}

.tile-off {
  opacity: 0.55;
}

.tile-img {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  border-radius: 14rpx;
  overflow: hidden;
  background: #1b2230;
}

.tile-img.noimg {
  background-image: radial-gradient(circle at 30% 25%, #2a3345 0%, #171d28 70%);
}

.tile-photo {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.wait-pill {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  min-width: 34rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
  color: #fff;
  background: rgba(20, 24, 32, 0.55);
}

.wait-pill.t1 { background: #22a45d; }
.wait-pill.t2 { background: #7bab2e; }
.wait-pill.t3 { background: #d9a441; }
.wait-pill.t4 { background: #e4702f; }
.wait-pill.t5 { background: #e0483f; }
.wait-pill.t0 { background: rgba(255, 255, 255, 0.16); font-size: 16rpx; font-weight: 600; }

.tile-premier {
  position: absolute;
  left: 6rpx;
  bottom: 6rpx;
  padding: 0 6rpx;
  border-radius: 6rpx;
  font-size: 14rpx;
  color: #ffd9a8;
  background: rgba(60, 40, 18, 0.55);
  border: 1rpx solid rgba(255, 180, 90, 0.35);
}

.tile-name {
  display: block;
  margin-top: 8rpx;
  padding: 0 2rpx;
  font-size: 19rpx;
  color: #e6ebf2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
