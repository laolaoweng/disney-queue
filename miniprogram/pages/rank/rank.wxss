/* pages/rank/rank.wxss —— 排行榜列表 */

.sk-card {
  padding: 40rpx 32rpx;
}

.sk-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: rgba(31, 88, 160, 0.07);
  margin-bottom: 22rpx;
}

.sk-line.w40 { width: 40%; }
.sk-line.w60 { width: 60%; }
.sk-line.w90 { width: 90%; }

/* 排序切换 */
.sortbar {
  display: flex;
  margin: 0 24rpx 20rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 88, 160, 0.07);
}

.sort-item {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #66748c;
}

.sort-item.active {
  background: rgba(47, 124, 246, 0.10);
  color: #164f9e;
  font-weight: 600;
}

/* 列表 */
.list {
  margin: 0 24rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(31, 88, 160, 0.07);
}

.row {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid rgba(31, 88, 160, 0.06);
}

.row:last-child {
  border-bottom: none;
}

.row-off {
  opacity: 0.45;
}

.row-rank {
  width: 44rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #5f6f87;
  text-align: center;
}

.row-rank.top {
  color: #164f9e;
}

.row-main {
  flex: 1;
  padding: 0 18rpx;
  overflow: hidden;
}

.row-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.row-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #16233a;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tag {
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  line-height: 1.6;
}

.tag.must {
  background: rgba(47, 124, 246, 0.12);
  color: #164f9e;
}

.tag.avoid {
  background: rgba(229, 72, 77, 0.14);
  color: #c9302c;
}

.tag.premier {
  background: rgba(232, 163, 23, 0.14);
  color: #96630a;
}

.tag.here {
  background: rgba(47, 124, 246, 0.12);
  color: #164f9e;
}

.tag.played {
  background: rgba(31, 88, 160, 0.10);
  color: #66748c;
}

.row-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #5a6a82;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.row-excluded {
  display: inline-block;
  margin-top: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  background: rgba(31, 88, 160, 0.07);
  color: #66748c;
}

.row-walk {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #5f6f87;
}

.row-right {
  width: 160rpx;
  flex-shrink: 0;
  text-align: right;
}

.row-wait {
  font-size: 52rpx;
  line-height: 1;
  letter-spacing: -1rpx;
}

.row-wait-unit {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #5a6a82;
}

.row-score {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #5f6f87;
}

/* 园区分组 */
.groupbar {
  display: flex;
  align-items: center;
  margin: 0 24rpx 20rpx;
}

.group-toggle {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 88, 160, 0.10);
  font-size: 24rpx;
  color: #66748c;
}

.group-toggle.on {
  background: rgba(47, 124, 246, 0.10);
  border-color: rgba(47, 124, 246, 0.22);
  color: #164f9e;
  font-weight: 600;
}

.groupbar-tip {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #64748c;
}

.group {
  margin: 0 24rpx 20rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(31, 88, 160, 0.07);
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: rgba(31, 88, 160, 0.04);
  border-bottom: 1rpx solid rgba(31, 88, 160, 0.06);
}

.group-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #16233a;
}

.group-count {
  font-size: 22rpx;
  color: #5a6a82;
}

/* ---------- 分时预测入口 ---------- */
.forecast-entry {
  display: flex;
  align-items: center;
  margin: 0 24rpx 20rpx;
  padding: 22rpx 24rpx;
  background: linear-gradient(135deg, rgba(47, 124, 246, 0.08), rgba(255, 255, 255, 0.92));
  border: 1rpx solid rgba(47, 124, 246, 0.16);
}

.fe-emoji {
  font-size: 38rpx;
  margin-right: 18rpx;
}

.fe-texts {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.fe-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #16233a;
}

.fe-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #66748c;
}

.fe-arrow {
  font-size: 36rpx;
  color: #164f9e;
  margin-left: 16rpx;
}


/* ---------------- 排队榜：图片卡片网格（参考界面风格） ---------------- */
.list-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 10rpx 24rpx 16rpx;
}

.refresh-pill {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(47, 124, 246, 0.3);
  background: rgba(47, 124, 246, 0.12);
  color: #164f9e;
  font-size: 24rpx;
  font-weight: 600;
}

.update-time {
  font-size: 22rpx;
  color: #5a6a82;
}

.tile-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin: 0 24rpx;
}

.tile {
  width: 23.2%;
  margin-bottom: 18rpx;
}

.tile-off {
  opacity: 0.55;
}

.tile-img {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  border-radius: 14rpx;
  overflow: hidden;
  background: #f0f6ff;
}

.tile-img.noimg {
  background-image: radial-gradient(circle at 30% 25%, #dbe9ff 0%, #ffffff 70%);
}

.tile-photo {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.wait-pill {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  min-width: 34rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
  color: #fff;
  background: rgba(22, 35, 58, 0.55);
}

.wait-pill.t1 { background: #0d7a52; }
.wait-pill.t2 { background: #5e9c2e; }
.wait-pill.t3 { background: #c98a12; }
.wait-pill.t4 { background: #e4702f; }
.wait-pill.t5 { background: #c9302c; }
.wait-pill.t0 { background: rgba(255, 255, 255, 0.88); color: #66748c; font-size: 16rpx; font-weight: 600; }

.tile-premier {
  position: absolute;
  left: 6rpx;
  bottom: 6rpx;
  padding: 0 6rpx;
  border-radius: 6rpx;
  font-size: 14rpx;
  color: #ffffff;
  background: rgba(22, 35, 58, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
}

.tile-name {
  display: block;
  margin-top: 8rpx;
  padding: 0 2rpx;
  font-size: 19rpx;
  color: #16233a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 排队榜顶部：乐园热度 + 奇梦之光 */
.rank-hero { padding: 26rpx 26rpx 24rpx; margin-bottom: 20rpx; }
.rh-top { display: flex; align-items: flex-end; gap: 18rpx; }
.rh-metric { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.rh-label { font-size: 22rpx; color: #5a6a82; }
.rh-num { font-size: 52rpx; font-weight: 800; color: #16233a; line-height: 1; }
.rh-num2 { font-size: 40rpx; font-weight: 800; color: #16233a; line-height: 1; }
.rh-unit { font-size: 20rpx; font-weight: 400; color: #7c8aa3; margin-left: 4rpx; }
.rh-pill {
  align-self: flex-start;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(47, 124, 246, .12);
  color: #164f9e;
}
.rh-pill.t1 { background: rgba(13, 122, 82, .12); color: #0d7a52; }
.rh-pill.t2 { background: rgba(47, 124, 246, .12); color: #164f9e; }
.rh-pill.t3 { background: rgba(150, 99, 10, .14); color: #96630a; }
.rh-pill.t4 { background: rgba(176, 74, 12, .14); color: #b04a0c; }
.rh-show {
  margin-top: 22rpx;
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #1f6fe5, #164f9e);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  color: #ffffff;
}
.rh-show-name { font-size: 26rpx; font-weight: 700; }
.rh-show-time { font-size: 30rpx; font-weight: 800; letter-spacing: 1rpx; }
.rh-show-meta { font-size: 20rpx; opacity: .8; }
