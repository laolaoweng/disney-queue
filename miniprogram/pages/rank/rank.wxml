<view class="page">
  <view class="topbar">
    <view>
      <text class="topbar-title">排队榜</text>
      <text class="topbar-sub">{{statsText}} · {{updatedText}}</text>
    </view>
  </view>

  <!-- 八大必玩 · 现在排队（点格子可直接操作） -->
  <view wx:if="{{highlightsRows.length}}" class="card rank-high">
    <view class="high-head">
      <text class="card-title">🎢 八大必玩 · 现在排队</text>
      <text class="high-link" bindtap="goWatchlist">去清单 ›</text>
    </view>
    <view class="hc-grid">
      <view
        wx:for="{{highlightsRows}}"
        wx:key="id"
        class="hc-item"
        data-id="{{item.id}}"
        bindtap="onTapHighlight"
      >
        <text class="hc-name">{{item.name}}</text>
        <text class="hc-wait {{item.closed ? 'closed' : item.waitClass}}">{{item.closed ? '关闭' : (item.waitMinutes === null ? '--' : item.waitMinutes + '′')}}</text>
      </view>
    </view>
  </view>

  <view class="sortbar">
    <view
      wx:for="{{sorts}}"
      wx:key="key"
      class="sort-item {{sortKey === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onSortTap"
    >{{item.label}}</view>
  </view>

  <view class="groupbar">
    <view class="group-toggle {{grouped ? 'on' : ''}}" bindtap="onGroupTap">
      {{grouped ? '按园区分组 ✓' : '按园区分组'}}
    </view>
    <text class="groupbar-tip">按主题园区看，同一园区顺路玩</text>
  </view>

  <!-- 分时预测入口 -->
  <view class="forecast-entry card" bindtap="goForecast">
    <text class="fe-emoji">📉</text>
    <view class="fe-texts">
      <text class="fe-title">分时预测</text>
      <text class="fe-sub">各项目几点人最少，一眼看出最空时段</text>
    </view>
    <text class="fe-arrow">›</text>
  </view>

  <view wx:if="{{loading}}" class="card sk-card">
    <view class="sk-line w60"></view>
    <view class="sk-line w90"></view>
    <view class="sk-line w40"></view>
  </view>

  <view wx:elif="{{error}}" class="empty">
    <text class="empty-emoji">📡</text>
    <text class="empty-title">{{error}}</text>
  </view>

  <block wx:elif="{{grouped}}">
    <view wx:for="{{groups}}" wx:key="land" wx:for-item="grp" class="group">
      <view class="group-head">
        <text class="group-name">{{grp.land}}</text>
        <text class="group-count">{{grp.rows.length}} 个</text>
      </view>
      <view
        wx:for="{{grp.rows}}"
        wx:key="id"
        wx:for-item="item"
        class="row {{item.excluded ? 'row-off' : ''}}"
        data-id="{{item.id}}"
        bindtap="onTapRow"
      >
        <view class="row-rank {{item.rank <= 3 && !item.excluded ? 'top' : ''}}">{{item.rank}}</view>

        <view class="row-main">
          <view class="row-title">
            <text class="row-name">{{item.name}}</text>
            <text wx:if="{{item.isMust}}" class="tag must">必玩</text>
            <text wx:if="{{item.premierAccess}}" class="tag premier">尊享</text>
            <text wx:if="{{item.isAvoid}}" class="tag avoid">避开</text>
            <text wx:if="{{item.isLast}}" class="tag here">我在这</text>
            <text wx:if="{{item.isPlayed}}" class="tag played">玩过</text>
          </view>
          <text class="row-sub">{{item.categoryText}}<text wx:if="{{item.heightCm}}"> · {{item.heightCm}}cm 以上</text></text>
          <view wx:if="{{item.excluded}}" class="row-excluded">{{item.excludedText}}</view>
          <text wx:elif="{{item.walkMinutes !== null}}" class="row-walk">步行 {{item.walkMinutes}} 分钟</text>
        </view>

        <view class="row-right">
          <text wx:if="{{!item.closed}}" class="num row-wait {{item.waitClass}}">{{item.waitMinutes}}</text>
          <text wx:else class="num row-wait closed">—</text>
          <text class="row-wait-unit">{{item.closed ? '已关闭' : '分钟'}}</text>
          <text class="row-score">{{item.excluded ? item.excludedText : item.scoreText + ' 分'}}</text>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="list">
      <view
        wx:for="{{rows}}"
        wx:key="id"
        class="row {{item.excluded ? 'row-off' : ''}}"
        data-id="{{item.id}}"
        bindtap="onTapRow"
      >
        <view class="row-rank {{item.rank <= 3 && !item.excluded ? 'top' : ''}}">{{item.rank}}</view>

        <view class="row-main">
          <view class="row-title">
            <text class="row-name">{{item.name}}</text>
            <text wx:if="{{item.isMust}}" class="tag must">必玩</text>
            <text wx:if="{{item.premierAccess}}" class="tag premier">尊享</text>
            <text wx:if="{{item.isAvoid}}" class="tag avoid">避开</text>
            <text wx:if="{{item.isLast}}" class="tag here">我在这</text>
            <text wx:if="{{item.isPlayed}}" class="tag played">玩过</text>
          </view>
          <text class="row-sub">{{item.land}} · {{item.categoryText}}<text wx:if="{{item.heightCm}}"> · {{item.heightCm}}cm 以上</text></text>
          <view wx:if="{{item.excluded}}" class="row-excluded">{{item.excludedText}}</view>
          <text wx:elif="{{item.walkMinutes !== null}}" class="row-walk">步行 {{item.walkMinutes}} 分钟</text>
        </view>

        <view class="row-right">
          <text wx:if="{{!item.closed}}" class="num row-wait {{item.waitClass}}">{{item.waitMinutes}}</text>
          <text wx:else class="num row-wait closed">—</text>
          <text class="row-wait-unit">{{item.closed ? '已关闭' : '分钟'}}</text>
          <text class="row-score">{{item.excluded ? item.excludedText : item.scoreText + ' 分'}}</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{!loading && !error}}" class="footnote">{{hintText}}</view>
</view>
