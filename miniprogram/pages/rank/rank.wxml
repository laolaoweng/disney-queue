<view class="page">
  <view class="list-topbar">
    <view class="refresh-pill" bindtap="onRefresh">↻ 刷新</view>
    <text class="update-time">更新时间：{{updatedFull}}</text>
  </view>

  <view class="rank-hero card">
    <view class="rh-top">
      <view class="rh-metric">
        <text class="rh-label">乐园热度</text>
        <text class="rh-num">{{heat}}</text>
        <text class="rh-pill {{heatTone}}">{{heatLevel}}</text>
      </view>
      <view class="rh-metric">
        <text class="rh-label">平均排队</text>
        <text class="rh-num2">{{avgWaitText}}<text class="rh-unit">分</text></text>
      </view>
      <view class="rh-metric">
        <text class="rh-label">开放项目</text>
        <text class="rh-num2">{{openCount}}<text class="rh-unit">个</text></text>
      </view>
    </view>
    <view class="rh-show" bindtap="goShows">
      <text class="rh-show-name">奇梦之光幻影秀</text>
      <text class="rh-show-time">{{showTimes}}</text>
      <text class="rh-show-meta">{{showMeta}}</text>
    </view>
  </view>

  <view class="sortbar">
    <view
      wx:for="{{sorts}}"
      wx:key="key"
      class="sort-item {{sortKey === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onSortTap"
    >{{item.label}}</view>
  </view>

  <view class="groupbar">
    <view class="group-toggle {{grouped ? 'on' : ''}}" bindtap="onGroupTap">
      {{grouped ? '按园区分组 ✓' : '按园区分组'}}
    </view>
    <text class="groupbar-tip">{{statsText}}</text>
  </view>

  <!-- 分时预测入口 -->
  <view class="forecast-entry card" bindtap="goForecast">
    <text class="fe-emoji">📉</text>
    <view class="fe-texts">
      <text class="fe-title">分时预测</text>
      <text class="fe-sub">各项目几点人最少，一眼看出最空时段</text>
    </view>
    <text class="fe-arrow">›</text>
  </view>

  <view wx:if="{{loading}}" class="card sk-card">
    <view class="sk-line w60"></view>
    <view class="sk-line w90"></view>
    <view class="sk-line w40"></view>
  </view>

  <view wx:elif="{{error}}" class="empty">
    <text class="empty-emoji">📡</text>
    <text class="empty-title">{{error}}</text>
  </view>

  <block wx:elif="{{grouped}}">
    <view wx:for="{{groups}}" wx:key="land" wx:for-item="grp" class="group">
      <view class="group-head">
        <text class="group-name">{{grp.land}}</text>
        <text class="group-count">{{grp.rows.length}} 个</text>
      </view>
      <view class="tile-grid">
        <view
          wx:for="{{grp.rows}}"
          wx:key="id"
          wx:for-item="item"
          class="tile {{item.excluded ? 'tile-off' : ''}}"
          data-id="{{item.id}}"
          bindtap="goDetail" bindlongpress="onTapRow"
        >
          <view class="tile-img {{item.imageUrl ? '' : 'noimg'}}">
            <image wx:if="{{item.imageUrl}}" class="tile-photo" src="{{item.imageUrl}}" mode="aspectFill" lazy-load></image>
            <text class="wait-pill {{item.waitTone}}">{{item.closed ? '关闭' : (item.waitMinutes === null ? '--' : item.waitMinutes)}}</text>
            <text wx:if="{{item.premierAccess}}" class="tile-premier">尊享</text>
          </view>
          <text class="tile-name">{{item.isMust ? '★ ' : ''}}{{item.name}}</text>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="tile-grid">
      <view
        wx:for="{{rows}}"
        wx:key="id"
        class="tile {{item.excluded ? 'tile-off' : ''}}"
        data-id="{{item.id}}"
        bindtap="goDetail" bindlongpress="onTapRow"
      >
        <view class="tile-img {{item.imageUrl ? '' : 'noimg'}}">
          <image wx:if="{{item.imageUrl}}" class="tile-photo" src="{{item.imageUrl}}" mode="aspectFill" lazy-load></image>
          <text class="wait-pill {{item.waitTone}}">{{item.closed ? '关闭' : (item.waitMinutes === null ? '--' : item.waitMinutes)}}</text>
          <text wx:if="{{item.premierAccess}}" class="tile-premier">尊享</text>
        </view>
        <text class="tile-name">{{item.isMust ? '★ ' : ''}}{{item.name}}</text>
      </view>
    </view>
  </block>

  <view wx:if="{{!loading && !error}}" class="footnote">{{hintText}}</view>
</view>
