/* pages/index/index.wxss —— 首屏：一张大卡片讲清楚「去哪、排多久、走多远、为什么」 */

.sk-card {
  padding: 40rpx 32rpx;
}

.sk-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.06);
  margin-bottom: 24rpx;
}

.sk-line.big {
  height: 64rpx;
}

.sk-line.w40 { width: 40%; }
.sk-line.w60 { width: 60%; }
.sk-line.w70 { width: 70%; }
.sk-line.w90 { width: 90%; }

.empty-btn {
  display: inline-block;
  margin-top: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: rgba(255, 138, 61, 0.16);
  color: #ffab6b;
  font-size: 26rpx;
}

/* ---------- 主卡 ---------- */
.hero {
  margin: 0 24rpx 24rpx;
  padding: 40rpx 36rpx 36rpx;
  border-radius: 36rpx;
  background: linear-gradient(160deg, #1d2536 0%, #151b26 55%, #141a24 100%);
  border: 1rpx solid rgba(255, 138, 61, 0.16);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.35);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-label {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #ffab6b;
}

.hero-score {
  display: flex;
  align-items: baseline;
}

.hero-score-num {
  font-size: 44rpx;
  color: #ff8a3d;
}

.hero-score-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: #ffab6b;
}

.hero-name {
  margin-top: 18rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: 1rpx;
  color: #ffffff;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.hero-tags .pill {
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.hero-nums {
  display: flex;
  align-items: stretch;
  margin-top: 32rpx;
}

.hero-num-block {
  flex: 1;
}

.hero-num-line {
  display: flex;
  align-items: baseline;
}

.hero-num {
  font-size: 88rpx;
  line-height: 1;
  letter-spacing: -2rpx;
}

.hero-num.walk {
  color: #9fb3cc;
}

.hero-num-unit {
  margin-left: 10rpx;
  font-size: 26rpx;
  color: #8b97aa;
}

.hero-num-label {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6f7a8c;
}

.hero-divider {
  width: 1rpx;
  margin: 8rpx 28rpx;
  background: rgba(255, 255, 255, 0.08);
}

.hero-reasons {
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
}

.reason {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.reason-dot {
  width: 10rpx;
  height: 10rpx;
  margin: 16rpx 14rpx 0 2rpx;
  border-radius: 50%;
  background: #ff8a3d;
  flex-shrink: 0;
}

.reason-text {
  font-size: 28rpx;
  line-height: 1.55;
  color: #d5dde8;
}

.hero-forecast {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8b97aa;
}

.hero-actions {
  display: flex;
  margin-top: 34rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary {
  background: linear-gradient(135deg, #ff9a4d, #ff6a1f);
  color: #1a1206;
  box-shadow: 0 10rpx 28rpx rgba(255, 106, 31, 0.28);
}

.btn-ghost {
  margin-left: 20rpx;
  background: rgba(255, 255, 255, 0.06);
  color: #c6cfdc;
  font-weight: 500;
}

/* ---------- 概况卡 ---------- */
.summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.summary-main {
  flex: 1;
  padding-right: 16rpx;
}

.summary-text {
  display: block;
  font-size: 26rpx;
  color: #dfe6f0;
}

.summary-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6f7a8c;
}

.summary-plan {
  text-align: right;
  flex-shrink: 0;
}

.summary-plan-num {
  font-size: 44rpx;
  color: #ff8a3d;
  line-height: 1;
}

.summary-plan-label {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #6f7a8c;
}

/* ---------- 必玩提醒 ---------- */
.must-card {
  padding: 28rpx 30rpx 8rpx;
}

.must-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 4rpx;
}

.must-hint {
  font-size: 20rpx;
  color: #6f7a8c;
}

.must-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
}

.must-main {
  flex: 1;
  padding-right: 20rpx;
  overflow: hidden;
}

.must-name-line {
  display: flex;
  align-items: center;
}

.must-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #eef2f7;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.must-closed {
  margin-left: 12rpx;
  flex-shrink: 0;
}

.must-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6f7a8c;
}

.must-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.must-wait {
  font-size: 46rpx;
  line-height: 1.1;
}

.must-wait.closed {
  font-size: 26rpx;
  line-height: 52rpx;
  color: #5a6473;
}

.must-unit {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #6f7a8c;
}

.must-go {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #ff9a4d;
}

/* ---------- 备选列表 ---------- */
.section {
  margin-top: 8rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 40rpx 18rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #b9c4d4;
}

.section-link {
  font-size: 24rpx;
  color: #ff9a4d;
}

.alt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx;
}

.alt-main {
  flex: 1;
  padding-right: 20rpx;
  overflow: hidden;
}

.alt-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #eef2f7;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.alt-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6f7a8c;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.alt-right {
  text-align: right;
  flex-shrink: 0;
}

.alt-wait {
  font-size: 52rpx;
  line-height: 1;
}

.alt-unit {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #6f7a8c;
}

/* ---------- 出发点选择条 ---------- */
.origin-bar {
  display: flex;
  align-items: center;
  margin: 0 24rpx 20rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.origin-label {
  font-size: 22rpx;
  color: #8b94a7;
  letter-spacing: 2rpx;
}

.origin-picker {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.origin-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #eef2f7;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.origin-caret {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #ff8a3d;
}

.origin-tip {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 20rpx;
  color: #5a6473;
}

/* ---------- 八大必玩 · 现在排队 ---------- */
.high-card {
  padding: 26rpx 26rpx 10rpx;
}

.high-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 14rpx;
}

.high-head .card-title {
  margin-bottom: 0;
}

.high-link {
  font-size: 22rpx;
  color: #ff9a4d;
}

.high-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 4rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.high-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.high-name-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.high-name {
  font-size: 28rpx;
  color: #eef2f7;
  margin-right: 8rpx;
}

.high-off {
  color: #7a8494;
}

.high-sub {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #5f6a7a;
}

.high-right {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.high-wait {
  font-size: 38rpx;
}

.high-unit {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #7a8494;
}

.high-add {
  min-width: 72rpx;
  margin-left: 18rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 138, 61, 0.4);
  text-align: center;
  font-size: 20rpx;
  color: #ff9a4d;
}

.high-add.on {
  background: rgba(255, 138, 61, 0.16);
  border-color: transparent;
  color: #ffbb85;
}

/* ---------- 分时预测入口 ---------- */
.forecast-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, rgba(255, 138, 61, 0.12), rgba(21, 27, 38, 0.9));
  border: 1rpx solid rgba(255, 138, 61, 0.22);
}

.fe-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.fe-emoji {
  font-size: 40rpx;
  margin-right: 18rpx;
}

.fe-texts {
  display: flex;
  flex-direction: column;
}

.fe-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #f2f5f9;
}

.fe-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8fa0b5;
}

.fe-arrow {
  font-size: 36rpx;
  color: #ff8a3d;
  margin-left: 16rpx;
}
