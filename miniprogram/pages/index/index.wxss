/* pages/index/index.wxss —— 首屏：一张大卡片讲清楚「去哪、排多久、走多远、为什么」 */

.sk-card {
  padding: 40rpx 32rpx;
}

.sk-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: rgba(31, 88, 160, 0.07);
  margin-bottom: 24rpx;
}

.sk-line.big {
  height: 64rpx;
}

.sk-line.w40 { width: 40%; }
.sk-line.w60 { width: 60%; }
.sk-line.w70 { width: 70%; }
.sk-line.w90 { width: 90%; }

.empty-btn {
  display: inline-block;
  margin-top: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: rgba(47, 124, 246, 0.12);
  color: #164f9e;
  font-size: 26rpx;
}

/* ---------- 主卡 ---------- */
.hero {
  margin: 0 24rpx 24rpx;
  padding: 40rpx 36rpx 36rpx;
  border-radius: 36rpx;
  background: linear-gradient(160deg, #f2f7ff 0%, #ffffff 55%, #ffffff 100%);
  border: 1rpx solid rgba(47, 124, 246, 0.12);
  box-shadow: 0 12rpx 32rpx rgba(47, 124, 246, 0.12);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-label {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #164f9e;
}

.hero-score {
  display: flex;
  align-items: baseline;
}

.hero-score-num {
  font-size: 44rpx;
  color: #164f9e;
}

.hero-score-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: #164f9e;
}

.hero-name {
  margin-top: 18rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: 1rpx;
  color: #16233a;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.hero-tags .pill {
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.hero-nums {
  display: flex;
  align-items: stretch;
  margin-top: 32rpx;
}

.hero-num-block {
  flex: 1;
}

.hero-num-line {
  display: flex;
  align-items: baseline;
}

.hero-num {
  font-size: 88rpx;
  line-height: 1;
  letter-spacing: -2rpx;
}

.hero-num.walk {
  color: #66748c;
}

.hero-num-unit {
  margin-left: 10rpx;
  font-size: 26rpx;
  color: #66748c;
}

.hero-num-label {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #5a6a82;
}

.hero-divider {
  width: 1rpx;
  margin: 8rpx 28rpx;
  background: rgba(31, 88, 160, 0.10);
}

.hero-reasons {
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(31, 88, 160, 0.08);
}

.reason {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.reason-dot {
  width: 10rpx;
  height: 10rpx;
  margin: 16rpx 14rpx 0 2rpx;
  border-radius: 50%;
  background: #164f9e;
  flex-shrink: 0;
}

.reason-text {
  font-size: 28rpx;
  line-height: 1.55;
  color: #2a3a55;
}

.hero-forecast {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #66748c;
}

.hero-actions {
  display: flex;
  margin-top: 34rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary {
  background: linear-gradient(135deg, #1f6fe5, #164f9e);
  color: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(47, 124, 246, 0.28);
}

.btn-ghost {
  margin-left: 20rpx;
  background: rgba(31, 88, 160, 0.07);
  color: #66748c;
  font-weight: 500;
}

/* ---------- 概况卡 ---------- */
.summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.summary-main {
  flex: 1;
  padding-right: 16rpx;
}

.summary-text {
  display: block;
  font-size: 26rpx;
  color: #16233a;
}

.summary-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #5a6a82;
}

.summary-plan {
  text-align: right;
  flex-shrink: 0;
}

.summary-plan-num {
  font-size: 44rpx;
  color: #164f9e;
  line-height: 1;
}

.summary-plan-label {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #5a6a82;
}

/* ---------- 必玩提醒 ---------- */
.must-card {
  padding: 28rpx 30rpx 8rpx;
}

.must-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 4rpx;
}

.must-hint {
  font-size: 20rpx;
  color: #5a6a82;
}

.must-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(31, 88, 160, 0.08);
}

.must-main {
  flex: 1;
  padding-right: 20rpx;
  overflow: hidden;
}

.must-name-line {
  display: flex;
  align-items: center;
}

.must-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #16233a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.must-closed {
  margin-left: 12rpx;
  flex-shrink: 0;
}

.must-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #5a6a82;
}

.must-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.must-wait {
  font-size: 46rpx;
  line-height: 1.1;
}

.must-wait.closed {
  font-size: 26rpx;
  line-height: 52rpx;
  color: #64748c;
}

.must-unit {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #5a6a82;
}

.must-go {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #164f9e;
}

/* ---------- 备选列表 ---------- */
.section {
  margin-top: 8rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 40rpx 18rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4a5b78;
}

.section-link {
  font-size: 24rpx;
  color: #164f9e;
}

.alt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx;
}

.alt-main {
  flex: 1;
  padding-right: 20rpx;
  overflow: hidden;
}

.alt-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #16233a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.alt-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #5a6a82;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.alt-right {
  text-align: right;
  flex-shrink: 0;
}

.alt-wait {
  font-size: 52rpx;
  line-height: 1;
}

.alt-unit {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #5a6a82;
}

/* ---------- 出发点选择条 ---------- */
.origin-bar {
  display: flex;
  align-items: center;
  margin: 0 24rpx 20rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(31, 88, 160, 0.05);
  border: 1rpx solid rgba(31, 88, 160, 0.07);
}

.origin-label {
  font-size: 22rpx;
  color: #66748c;
  letter-spacing: 2rpx;
}

.origin-picker {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.origin-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #16233a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.origin-caret {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #164f9e;
}

.origin-tip {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 20rpx;
  color: #64748c;
}

/* ---------- 八大必玩 · 现在排队 ---------- */
.high-card {
  padding: 26rpx 26rpx 10rpx;
}

.high-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 14rpx;
}

.high-head .card-title {
  margin-bottom: 0;
}

.high-link {
  font-size: 22rpx;
  color: #164f9e;
}

.high-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 4rpx;
  border-top: 1rpx solid rgba(31, 88, 160, 0.06);
}

.high-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.high-name-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.high-name {
  font-size: 28rpx;
  color: #16233a;
  margin-right: 8rpx;
}

.high-off {
  color: #5a6a82;
}

.high-sub {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #5f6f87;
}

.high-right {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.high-wait {
  font-size: 38rpx;
}

.high-unit {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #5a6a82;
}

.high-add {
  min-width: 72rpx;
  margin-left: 18rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(47, 124, 246, 0.28);
  text-align: center;
  font-size: 20rpx;
  color: #164f9e;
}

.high-add.on {
  background: rgba(47, 124, 246, 0.12);
  border-color: transparent;
  color: #164f9e;
}

/* ---------- 分时预测入口 ---------- */
.forecast-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, rgba(47, 124, 246, 0.08), rgba(31, 88, 160, 0.92));
  border: 1rpx solid rgba(47, 124, 246, 0.16);
}

.fe-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.fe-emoji {
  font-size: 40rpx;
  margin-right: 18rpx;
}

.fe-texts {
  display: flex;
  flex-direction: column;
}

.fe-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #16233a;
}

.fe-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #66748c;
}

.fe-arrow {
  font-size: 36rpx;
  color: #164f9e;
  margin-left: 16rpx;
}

/* ---------- 今日客流卡 ---------- */
.crowd-card {
  margin: 0 24rpx 24rpx;
  padding: 28rpx 28rpx 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid rgba(31, 88, 160, 0.06);
  box-shadow: 0 6rpx 18rpx rgba(31, 88, 160, 0.08);
}

.crowd-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.crowd-left {
  flex: 0 0 auto;
}

.crowd-label {
  display: block;
  font-size: 22rpx;
  color: #66748c;
  letter-spacing: 1rpx;
}

.crowd-heat-line {
  display: flex;
  align-items: baseline;
  margin-top: 4rpx;
}

.crowd-heat {
  font-size: 64rpx;
  line-height: 1.1;
  color: #16233a;
}

.crowd-heat.none {
  color: #64748c;
}

.crowd-heat-unit {
  margin-left: 4rpx;
  font-size: 20rpx;
  color: #5f6f87;
}

.crowd-level {
  margin-left: 14rpx;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.crowd-level.tone-ok {
  background: rgba(23, 166, 115, 0.12);
  color: #0d7a52;
}

.crowd-level.tone-warn {
  background: rgba(232, 163, 23, 0.14);
  color: #96630a;
}

.crowd-level.tone-hot {
  background: rgba(239, 122, 47, 0.14);
  color: #b04a0c;
}

.crowd-level.tone-danger {
  background: rgba(229, 72, 77, 0.12);
  color: #c9302c;
}

.crowd-level.tone-ghost {
  background: rgba(31, 88, 160, 0.06);
  color: #5f6f87;
}

.crowd-right {
  display: flex;
  flex: 1;
  justify-content: flex-end;
  margin-left: 16rpx;
}

.crowd-metric {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 26rpx;
}

.crowd-metric-num {
  font-size: 30rpx;
  color: #16233a;
  line-height: 1.25;
}

.crowd-metric-num.crowd-hours {
  font-size: 24rpx;
  color: #164f9e;
}

.crowd-metric-label {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: #5f6f87;
}

.crowd-bars {
  display: flex;
  align-items: flex-end;
  height: 92rpx;
  margin-top: 18rpx;
}

.crowd-bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  min-width: 0;
}

.crowd-bar-track {
  width: 100%;
  height: 66rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 2rpx;
  box-sizing: border-box;
}

.crowd-bar-fill {
  width: 68%;
  max-width: 14rpx;
  border-radius: 6rpx 6rpx 3rpx 3rpx;
  background: linear-gradient(180deg, rgba(47, 124, 246, 0.5), rgba(47, 124, 246, 0.22));
}

.crowd-bar-fill.current {
  background: linear-gradient(180deg, #1f6fe5, #164f9e);
}

.crowd-bar-hour {
  margin-top: 4rpx;
  font-size: 16rpx;
  color: #64748c;
  line-height: 1;
}

.crowd-bar-col.current .crowd-bar-hour {
  color: #164f9e;
  font-weight: 600;
}

.crowd-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.crowd-note {
  font-size: 22rpx;
  color: #66748c;
}

.crowd-go {
  font-size: 22rpx;
  color: #164f9e;
}
