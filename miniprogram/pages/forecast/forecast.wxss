/* pages/forecast/forecast.wxss —— 分时预测页（深色卡片 + 橙色强调） */

.day-seg {
  display: flex;
  background: #151b26;
  border-radius: 24rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.day-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 20rpx;
  color: #9aa4b2;
  font-size: 26rpx;
}

.day-item.active {
  background: rgba(255, 138, 61, 0.16);
  color: #ff8a3d;
  font-weight: 600;
}

.chips {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.chip {
  display: inline-block;
  padding: 14rpx 26rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #151b26;
  color: #c3ccd9;
  font-size: 24rpx;
  border: 2rpx solid transparent;
}

.chip.active {
  background: rgba(255, 138, 61, 0.14);
  border-color: rgba(255, 138, 61, 0.6);
  color: #ff8a3d;
}

.chip-all {
  color: #8fa0b5;
  border-style: dashed;
  border-color: rgba(143, 160, 181, 0.4);
}

.chart-card {
  padding: 24rpx 20rpx 20rpx;
}

.chart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.chart-title-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.chart-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #f2f5f9;
  margin-right: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chart-badge {
  font-size: 20rpx;
  color: #ffb020;
  border: 2rpx solid rgba(255, 176, 32, 0.5);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.best-banner {
  display: flex;
  align-items: flex-start;
  background: rgba(53, 208, 127, 0.1);
  border: 2rpx solid rgba(53, 208, 127, 0.35);
  border-radius: 18rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 20rpx;
}

.best-emoji {
  font-size: 24rpx;
  margin-right: 10rpx;
  line-height: 1.4;
}

.best-text {
  flex: 1;
  font-size: 26rpx;
  color: #b7f0d0;
  line-height: 1.45;
}

.chart {
  display: flex;
  align-items: flex-end;
  height: 330rpx;
  padding: 0 4rpx;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.bar-tag {
  height: 22rpx;
  line-height: 22rpx;
  font-size: 16rpx;
  color: transparent;
  white-space: nowrap;
}

.bar-tag.on {
  color: #35d07f;
  font-weight: 600;
}

.bar-value {
  font-size: 18rpx;
  color: #7a8494;
  margin-bottom: 6rpx;
  height: 24rpx;
}

.bar-value.best {
  color: #35d07f;
  font-weight: 600;
}

.bar-track {
  width: 32rpx;
  height: 240rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 10rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.bar-fill {
  width: 100%;
  border-radius: 10rpx;
  background: linear-gradient(180deg, #ffa15c 0%, #ff8a3d 100%);
  transition: height 0.3s ease;
}

.bar-fill.best {
  background: linear-gradient(180deg, #6fe3a8 0%, #35d07f 100%);
}

.bar-fill.empty {
  background: rgba(255, 255, 255, 0.06);
}

.bar-hour {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #7a8494;
}

.bar-hour.best {
  color: #35d07f;
  font-weight: 600;
}

.chart-legend {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #35d07f;
  margin-right: 10rpx;
}

.legend-text {
  font-size: 22rpx;
  color: #8fa0b5;
}

.chart-peak {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #ff9d6b;
}

.table-card {
  margin-top: 20rpx;
  padding: 22rpx 18rpx;
}

.tbl {
  margin-top: 12rpx;
}

.tbl-row {
  display: flex;
  align-items: center;
  padding: 14rpx 4rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  font-size: 24rpx;
  color: #c3ccd9;
}

.tbl-row.best {
  background: rgba(53, 208, 127, 0.06);
  border-radius: 12rpx;
}

.tbl-row.best .tbl-hour,
.tbl-row.best .tbl-avg {
  color: #35d07f;
}

.tbl-head {
  font-size: 22rpx;
  color: #7a8494;
  border-bottom-color: rgba(255, 255, 255, 0.1);
}

.tbl-row:last-child {
  border-bottom: none;
}

.tbl-hour {
  width: 120rpx;
  color: #e8edf3;
}

.tbl-avg {
  width: 170rpx;
}

.tbl-wd {
  width: 160rpx;
  color: #9aa4b2;
}

.tbl-we {
  width: 160rpx;
  color: #9aa4b2;
}

.tbl-days {
  flex: 1;
  text-align: right;
  color: #7a8494;
}

.small-empty {
  padding: 40rpx 0;
}

.sk-card {
  padding: 28rpx;
}

.sk-line {
  height: 22rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.06);
  margin-bottom: 16rpx;
}

.sk-line.big {
  height: 56rpx;
}

.sk-line.w40 { width: 40%; }
.sk-line.w60 { width: 60%; }
.sk-line.w70 { width: 70%; }
.sk-line.w90 { width: 90%; }

.footnote {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #5f6b7d;
  line-height: 1.6;
  padding: 0 6rpx 30rpx;
}
