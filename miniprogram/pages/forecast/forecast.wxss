/* pages/forecast/forecast.wxss —— 分时预测页（深色卡片 + 橙色强调） */

.day-seg {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.day-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 20rpx;
  color: #66748c;
  font-size: 26rpx;
}

.day-item.active {
  background: rgba(47, 124, 246, 0.12);
  color: #164f9e;
  font-weight: 600;
}

.chips {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.chip {
  display: inline-block;
  padding: 14rpx 26rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #66748c;
  font-size: 24rpx;
  border: 2rpx solid transparent;
}

.chip.active {
  background: rgba(47, 124, 246, 0.10);
  border-color: rgba(47, 124, 246, 0.45);
  color: #164f9e;
}

.chip-all {
  color: #66748c;
  border-style: dashed;
  border-color: rgba(102, 116, 140, 0.4);
}

.chart-card {
  padding: 24rpx 20rpx 20rpx;
}

.chart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.chart-title-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.chart-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #16233a;
  margin-right: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chart-badge {
  font-size: 20rpx;
  color: #96630a;
  border: 2rpx solid rgba(232, 163, 23, 0.4);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.best-banner {
  display: flex;
  align-items: flex-start;
  background: rgba(23, 166, 115, 0.12);
  border: 2rpx solid rgba(23, 166, 115, 0.35);
  border-radius: 18rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 20rpx;
}

.best-emoji {
  font-size: 24rpx;
  margin-right: 10rpx;
  line-height: 1.4;
}

.best-text {
  flex: 1;
  font-size: 26rpx;
  color: #0f7a52;
  line-height: 1.45;
}

.chart {
  display: flex;
  align-items: flex-end;
  height: 330rpx;
  padding: 0 4rpx;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.bar-tag {
  height: 22rpx;
  line-height: 22rpx;
  font-size: 16rpx;
  color: transparent;
  white-space: nowrap;
}

.bar-tag.on {
  color: #0d7a52;
  font-weight: 600;
}

.bar-value {
  font-size: 18rpx;
  color: #5a6a82;
  margin-bottom: 6rpx;
  height: 24rpx;
}

.bar-value.best {
  color: #0d7a52;
  font-weight: 600;
}

.bar-track {
  width: 32rpx;
  height: 240rpx;
  background: rgba(31, 88, 160, 0.05);
  border-radius: 10rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.bar-fill {
  width: 100%;
  border-radius: 10rpx;
  background: linear-gradient(180deg, #5b9bff 0%, #164f9e 100%);
  transition: height 0.3s ease;
}

.bar-fill.best {
  background: linear-gradient(180deg, #4fc99a 0%, #0d7a52 100%);
}

.bar-fill.empty {
  background: rgba(31, 88, 160, 0.07);
}

.bar-hour {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #5a6a82;
}

.bar-hour.best {
  color: #0d7a52;
  font-weight: 600;
}

.chart-legend {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #0d7a52;
  margin-right: 10rpx;
}

.legend-text {
  font-size: 22rpx;
  color: #66748c;
}

.chart-peak {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #164f9e;
}

.table-card {
  margin-top: 20rpx;
  padding: 22rpx 18rpx;
}

.tbl {
  margin-top: 12rpx;
}

.tbl-row {
  display: flex;
  align-items: center;
  padding: 14rpx 4rpx;
  border-bottom: 1rpx solid rgba(31, 88, 160, 0.06);
  font-size: 24rpx;
  color: #66748c;
}

.tbl-row.best {
  background: rgba(23, 166, 115, 0.08);
  border-radius: 12rpx;
}

.tbl-row.best .tbl-hour,
.tbl-row.best .tbl-avg {
  color: #0d7a52;
}

.tbl-head {
  font-size: 22rpx;
  color: #5a6a82;
  border-bottom-color: rgba(31, 88, 160, 0.12);
}

.tbl-row:last-child {
  border-bottom: none;
}

.tbl-hour {
  width: 120rpx;
  color: #16233a;
}

.tbl-avg {
  width: 170rpx;
}

.tbl-wd {
  width: 160rpx;
  color: #66748c;
}

.tbl-we {
  width: 160rpx;
  color: #66748c;
}

.tbl-days {
  flex: 1;
  text-align: right;
  color: #5a6a82;
}

.small-empty {
  padding: 40rpx 0;
}

.sk-card {
  padding: 28rpx;
}

.sk-line {
  height: 22rpx;
  border-radius: 10rpx;
  background: rgba(31, 88, 160, 0.07);
  margin-bottom: 16rpx;
}

.sk-line.big {
  height: 56rpx;
}

.sk-line.w40 { width: 40%; }
.sk-line.w60 { width: 60%; }
.sk-line.w70 { width: 70%; }
.sk-line.w90 { width: 90%; }

.footnote {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #5f6f87;
  line-height: 1.6;
  padding: 0 6rpx 30rpx;
}
