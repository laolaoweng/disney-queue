/**
 * app.wxss —— 全局浅色主题：淡蓝渐变底 + 白色圆角卡片 + 蓝色主色
 * 语义色：绿=排队短(<=20) / 黄=中等(<=45) / 红=长(>45) / 灰=关闭
 * 色板用 CSS 变量，页面 wxss 可直接引用（var(--primary) 等）
 */
page {
  /* ---------- 浅色色板 ---------- */
  --bg-top: #e8f2ff;
  --bg-mid: #f7fbff;
  --bg-bottom: #f6f8fc;
  --card: #ffffff;
  --card-soft: #f4f8ff;

  --text: #16233a;
  --text-strong: #0f1a2c;
  --muted: #66748c;
  --muted-light: #8b97aa;

  --primary: #2f7cf6;
  --primary-deep: #1f61d6;
  --primary-soft: #eaf2ff;
  --primary-line: rgba(47, 124, 246, 0.22);

  --ok: #17a673;
  --ok-soft: rgba(23, 166, 115, 0.12);
  --warn: #e8a317;
  --warn-soft: rgba(232, 163, 23, 0.14);
  --hot: #ef7a2f;
  --danger: #e5484d;
  --danger-soft: rgba(229, 72, 77, 0.12);
  --closed: #9aa6b8;

  --line: rgba(31, 88, 160, 0.08);
  --line-strong: rgba(31, 88, 160, 0.14);
  --shadow: 0 6rpx 18rpx rgba(31, 88, 160, 0.08);
  --shadow-lg: 0 14rpx 40rpx rgba(31, 88, 160, 0.12);

  background: linear-gradient(180deg, #e8f2ff 0%, #f7fbff 40%, #f6f8fc 100%);
  background-attachment: fixed;
  color: #16233a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

.page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ---------- 通用文字 ---------- */
.muted {
  color: #66748c;
}

.small {
  font-size: 22rpx;
}

.title-lg {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #16233a;
}

.num {
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.short { color: #17a673; }
.mid { color: #e8a317; }
.long { color: #e5484d; }
.closed { color: #9aa6b8; }

/* ---------- 顶部栏 ---------- */
.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
}

.topbar-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #16233a;
}

.topbar-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #66748c;
}

.refresh-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 50%;
  background: #ffffff;
  color: #2f7cf6;
  font-size: 34rpx;
  border: 1rpx solid rgba(47, 124, 246, 0.16);
  box-shadow: 0 4rpx 12rpx rgba(31, 88, 160, 0.08);
}

.refresh-btn.spinning {
  opacity: 0.4;
}

/* ---------- 卡片 ---------- */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(31, 88, 160, 0.06);
  box-shadow: 0 6rpx 18rpx rgba(31, 88, 160, 0.08);
  box-sizing: border-box;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #16233a;
}

.hr {
  height: 1rpx;
  background: rgba(31, 88, 160, 0.08);
  margin: 24rpx 0;
}

/* ---------- 药丸 / 标签 ---------- */
.pill {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: #eaf2ff;
  color: #2f7cf6;
}

.badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  background: rgba(47, 124, 246, 0.12);
  color: #2f7cf6;
  margin-left: 12rpx;
}

.badge.ghost {
  background: rgba(31, 88, 160, 0.06);
  color: #66748c;
}

.badge.ok {
  background: rgba(23, 166, 115, 0.12);
  color: #17a673;
}

.badge.warn {
  background: rgba(232, 163, 23, 0.14);
  color: #b07c08;
}

/* ---------- 空的 / 错误状态 ---------- */
.empty {
  margin: 0 24rpx;
  padding: 72rpx 40rpx;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: center;
  color: #66748c;
  border: 1rpx solid rgba(31, 88, 160, 0.06);
  box-shadow: 0 6rpx 18rpx rgba(31, 88, 160, 0.06);
}

.empty-emoji {
  display: block;
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: #16233a;
  margin-bottom: 12rpx;
  font-weight: 600;
}

/* ---------- 底部说明 ---------- */
.footnote {
  margin: 8rpx 40rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #8b97aa;
}
